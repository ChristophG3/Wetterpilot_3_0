                        <constraints>
                            <constraint firstItem="Logo" firstAttribute="centerX" secondItem="View" secondAttribute="centerX" id="cx"/>
                            <constraint firstItem="Logo" firstAttribute="centerY" secondItem="View" secondAttribute="centerY" id="cy"/>
