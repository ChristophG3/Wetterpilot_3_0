    "comparison.notification.explanation.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wetterpilot kann einmal lokal benachrichtigen, wenn der gemeinsame Zeitraum in das 16-Tage-Fenster gelangt. Es gibt keine Zusage für Hintergrundaktualisierungen oder Wetteränderungsmeldungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wetterpilot can send one local notification when the shared period enters the 16-day window. It does not promise background updates or weather-change notifications."
          }
        }
      }
    },
