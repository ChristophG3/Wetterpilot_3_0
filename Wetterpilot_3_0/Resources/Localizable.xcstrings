    "notification.explanation.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wetterpilot kann dich einmal lokal benachrichtigen, sobald der erste Reisetag in das 16-Tage-Vorhersagefenster gelangt. Die App verspricht keine Hintergrundaktualisierung und meldet keine Wetteränderungen."
          }
